#Copy this file to .env and replace the placeholder.
#.env is git-ignore and must never be committed.
#Server direction, database name, user id and password must be replaced with your own values.
#Server direction,port example "Server=localhost,1433

ConnectionStrings__BookingDatabase="Server=YourServerDirection;Database=YourDatabase;User Id=YourID;Password=YourPassword;Encrypt=True;TrustServerCertificate=True;"